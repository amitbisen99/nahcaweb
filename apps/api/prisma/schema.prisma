generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

enum MembershipType {
  regular
  student
  institutional
  conference
}

enum MembershipStatus {
  active
  expired
  pending
}

enum CouponDiscountType {
  percent
  fixed_amount
  complimentary
}

enum PaymentType {
  membership
  donation
  conference
  endorsement
  event
  product
}

enum EventRegistrationStatus {
  pending
  active
}

enum ProductType {
  video
  file
}

// Mirrors EventRegistrationStatus's convention exactly: pending until the
// linked Payment activates it, then active — a buyer only gets the video
// embed / file download once their order is active.
enum ProductOrderStatus {
  pending
  active
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum ForumTopicStatus {
  pending
  published
  rejected
}

enum ForumVisibility {
  public
  members_only
}

enum ArticleCategory {
  Podcast
  Presentation
  Referral
  Ethics
}

enum WebinarAccess {
  open
  members_only
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  name         String
  role         Role         @default(member)
  // Admin-controlled login gate — set false to block sign-in without
  // deleting the account or its purchase history. Checked at login only
  // (doesn't invalidate an already-issued JWT mid-session).
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  payments     Payment[]
  profile      MemberProfile?
  // Set only for the institution's own login (the paying party) — see
  // InstitutionSponsorship for the institution-sponsored-membership feature.
  institutionSponsorship InstitutionSponsorship?
  claimedCodes           InstitutionClaimCode[]
  passwordResetTokens    PasswordResetToken[]
  eventRegistrations     EventRegistration[]
  forumTopics            ForumTopic[]
  forumReplies           ForumReply[]
  productOrders          ProductOrder[]
}

// Single-use, expiring token emailed as a link on "forgot password". See
// POST /auth/forgot-password (creates) and POST /auth/reset-password
// (consumes) in routes/auth.ts.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Extended demographic/professional questionnaire collected on the
// Regular/Student membership signup form (see the "Fields for collecting
// member information" doc). Kept separate from User so the core auth model
// stays lean — everything here is optional.
model MemberProfile {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  user                    User     @relation(fields: [userId], references: [id])
  preferredPronouns       String?
  mailingAddress          String?  @db.Text
  phone                   String?
  usesWhatsapp            Boolean?
  whatsappContactOk       Boolean?
  // string[] of selected traditions (see MEMBER_FORM_OPTIONS on the frontend)
  religiousTraditions     Json?
  religiousTraditionOther String?
  // "chaplain" | "student"
  primaryRole             String?
  // { employerName, jobTitle, employmentType }[]
  employment              Json?
  hearAboutUs             String?
  hearAboutUsOther        String?
  // string[] of selected care contexts
  careContexts            Json?
  boardCertified          Boolean?
  boardCertifiedOrg       String?
  endorsed                Boolean?
  endorsedBy              String?
  // string[] of selected organization memberships
  orgMemberships          Json?
  orgMembershipOther      String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Membership {
  id                   Int              @id @default(autoincrement())
  userId               Int
  user                 User             @relation(fields: [userId], references: [id])
  type                 MembershipType
  status               MembershipStatus @default(pending)
  startDate            DateTime?
  endDate              DateTime?
  priceCents           Int
  stripeSubscriptionId String?
  // Institutional only: null on the institution's own paying membership,
  // set to the InstitutionSponsorship id (as a string) on a sponsored
  // student's membership — that's how the two are told apart.
  groupId              String?
  // Institutional only: seats purchased. Used to size each claim-code batch.
  studentCount         Int?
  createdAt            DateTime         @default(now())
  payment              Payment?

  @@index([userId])
  @@index([groupId])
}

// One per institution — created when their sponsorship subscription first
// activates (see activatePayment in paymentActivation.ts). Renewed in place
// every 24 months (see the Stripe webhook's invoice.paid handling), which
// extends endDate and adds a fresh batch of claim codes.
model InstitutionSponsorship {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  user                 User     @relation(fields: [userId], references: [id])
  seatCount            Int
  stripeSubscriptionId String?
  startDate            DateTime
  endDate              DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  codes                InstitutionClaimCode[]

  @@index([stripeSubscriptionId])
}

// A single-use code from a sponsorship's batch. Redeemed via POST
// /institutions/claim (new student) or POST /institutions/redeem (existing
// member extending) — either way it results in a new Membership row.
model InstitutionClaimCode {
  id              Int                     @id @default(autoincrement())
  sponsorshipId   Int
  sponsorship     InstitutionSponsorship  @relation(fields: [sponsorshipId], references: [id])
  code            String                  @unique
  claimedByUserId Int?
  claimedByUser   User?                   @relation(fields: [claimedByUserId], references: [id])
  claimedAt       DateTime?
  createdAt       DateTime                @default(now())

  @@index([sponsorshipId])
}

model MembershipPlan {
  id                   Int            @id @default(autoincrement())
  type                 MembershipType @unique
  name                 String
  priceCents           Int
  term                 String
  note                 String         @db.Text
  benefits             String         @db.Text
  tooltip              String?        @db.Text
  minStudents          Int?
  pricePerStudentCents Int?
  updatedAt            DateTime       @updatedAt
  createdAt            DateTime       @default(now())
}

model Donation {
  id              Int      @id @default(autoincrement())
  donorName       String
  donorEmail      String
  amountCents     Int
  purpose         String?
  // No longer collected on the public donation form (client removed the
  // "monthly recurring" option) — kept on existing rows rather than
  // migrated away, and the API still accepts it for backward compat, but
  // it always comes through false from the form now.
  recurring       Boolean  @default(false)
  // Full mailing address as a single free-text field, per the donation
  // form's own "full address" field — not split into street/city/state/zip.
  address         String?  @db.Text
  stripePaymentId String?
  createdAt       DateTime @default(now())
  payment         Payment?
}

model Coupon {
  id            Int                @id @default(autoincrement())
  name          String
  code          String             @unique
  discountType  CouponDiscountType
  // Meaning depends on discountType: a 0-100 percentage for `percent`, cents
  // for `fixed_amount`, unused for `complimentary`.
  discountValue Int
  // What this coupon can be applied to — a JSON array of membership plan
  // types ("regular"/"student"/"institutional") and/or the sentinel value
  // "nahca_programmes" (an Event/Webinar, via eventCode below). At least
  // one entry is required going forward (enforced in the API, not the DB —
  // stays nullable so pre-existing coupons created under the old "empty
  // means applies to everything" rule aren't broken by this migration).
  appliesTo     Json?
  // Set only when appliesTo includes "nahca_programmes" — the specific
  // Event.eventCode or Webinar.eventCode this coupon is scoped to. Not a
  // real foreign key since it can point at either table; existence is
  // checked in the API on save. Not consulted by any checkout flow yet —
  // event/webinar payment + coupon redemption is a future phase.
  eventCode     String?
  validFrom     DateTime?
  validTill     DateTime?
  maxUses       Int?
  usedCount     Int                @default(0)
  published     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payments      Payment[]
}

model Payment {
  id           Int           @id @default(autoincrement())
  userId       Int?
  user         User?         @relation(fields: [userId], references: [id])
  donationId   Int?          @unique
  donation     Donation?     @relation(fields: [donationId], references: [id])
  membershipId Int?          @unique
  membership   Membership?   @relation(fields: [membershipId], references: [id])
  eventRegistrationId Int?               @unique
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id])
  productOrderId Int?          @unique
  productOrder   ProductOrder? @relation(fields: [productOrderId], references: [id])
  couponId     Int?
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  type         PaymentType
  amountCents  Int
  stripeRef    String?
  status       PaymentStatus @default(pending)
  createdAt    DateTime      @default(now())
  receipt      Receipt?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([couponId])
}

model Receipt {
  id        Int      @id @default(autoincrement())
  paymentId Int      @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  sentAt    DateTime @default(now())
  emailBody String   @db.Text
}

// --- Content management (replaces the retired Strapi CMS) ---

model Event {
  id               Int           @id @default(autoincrement())
  title            String
  date             DateTime
  time             String?
  description      String?       @db.Text
  registrationLink String?
  // Optional fee to join, in cents (same convention as every other price
  // field in this app) — null/0 means free. Collected via
  // EventRegistration/Payment when someone clicks Join (see
  // routes/eventRegistrations.ts).
  priceCents       Int?
  featuredImageUrl String?
  speakers         Json?
  access           WebinarAccess @default(open)
  published        Boolean       @default(false)
  // Unique, admin-facing code generated on creation (see lib/eventCodes.ts)
  // — used to scope a Coupon to this specific event.
  eventCode        String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([published])
  @@index([access])
}

model Webinar {
  id                Int           @id @default(autoincrement())
  title             String
  description       String?       @db.Text
  zoomOrYoutubeLink String?
  // Optional fee to join, in cents — null/0 means free. Collected via
  // EventRegistration/Payment when someone clicks Join (see
  // routes/eventRegistrations.ts).
  priceCents        Int?
  speakerInfo       String?       @db.Text
  speakers          Json?
  featuredImageUrl  String?
  access            WebinarAccess @default(open)
  published         Boolean       @default(false)
  // Unique, admin-facing code generated on creation (see lib/eventCodes.ts)
  // — used to scope a Coupon to this specific webinar.
  eventCode         String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([published])
  @@index([access])
}

// One row per person who clicks Join on an Event or Webinar. eventCode
// matches Event.eventCode or Webinar.eventCode — same "which one, not a
// real FK since it spans two tables" convention Coupon.eventCode already
// uses. A logged-in member's quick-join sets userId and nothing else (see
// POST /event-registrations/quick-join) — no payment, no questionnaire.
// Everyone else (guest) leaves userId null and fills in the fields below
// via the join form; payment (if the event has a fee) is optional too,
// null for a free event or a complimentary coupon.
model EventRegistration {
  id        Int    @id @default(autoincrement())
  eventCode String
  userId    Int?
  user      User?  @relation(fields: [userId], references: [id])
  name      String?
  email     String?
  preferredPronouns       String?
  mailingAddress          String?  @db.Text
  phone                   String?
  usesWhatsapp            Boolean?
  whatsappContactOk       Boolean?
  religiousTraditions     Json?
  religiousTraditionOther String?
  primaryRole             String?
  employment              Json?
  hearAboutUs             String?
  hearAboutUsOther        String?
  status    EventRegistrationStatus @default(pending)
  createdAt DateTime @default(now())
  payment   Payment?

  @@index([eventCode])
  @@index([userId])
}

// Audit trail for the admin's bulk "Receipt Email" send (see routes/
// eventRegistrations.ts's POST /:eventCode/send-receipt-email) — one row
// per send, not per recipient. sentByEmail is denormalized (not a User
// relation) since this is just a record of what happened, not a live
// reference that needs to stay valid if the admin account ever changes.
model ReceiptEmailLog {
  id          Int      @id @default(autoincrement())
  eventCode   String
  subject     String
  sentByEmail String
  sentCount   Int
  failedCount Int
  createdAt   DateTime @default(now())

  @@index([eventCode])
}

model ConferenceVideo {
  id        Int      @id @default(autoincrement())
  title     String
  videoUrl  String
  year      Int?
  category  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model Article {
  id           Int             @id @default(autoincrement())
  title        String
  richTextBody String?         @db.Text
  category     ArticleCategory
  published    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([published])
}

model Newsletter {
  id                   Int       @id @default(autoincrement())
  title                String
  fileUrl              String?
  mailchimpCampaignUrl String?
  publishedDate        DateTime?
  published            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([published])
}

// Local record of who signed up via the site footer's "Get our monthly
// newsletter & updates" form — NOT the same thing as the Newsletter model
// above (that's published newsletter PDFs). Brevo is the actual mailing
// list (see lib/brevoContacts.ts); this table exists purely so admins have
// a record of footer signups without needing to log into Brevo. Members are
// pushed to the same Brevo list directly from their signup/claim flow and
// don't get a row here (they're already tracked as Users).
model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Board {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  bio       String?  @db.Text
  photoUrl  String?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

// Admin-managed, shipped with a starter set (see the matching migration's
// seed insert) — General Discussion, Chaplaincy Practice, Events &
// Programs, Announcements. No admin CRUD UI for categories yet (out of
// scope for this first pass); add/rename directly in the DB if needed
// until that's built.
model ForumCategory {
  id        Int          @id @default(autoincrement())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  topics    ForumTopic[]
}

// A topic always starts `pending` and is invisible to everyone but its
// author and admin until an admin approves it (-> `published`) or rejects
// it (-> `rejected`, with rejectionReason set — still visible only to the
// author, who sees why; admin can permanently delete a rejected topic from
// the moderation view whenever they choose). Replies are NOT moderated —
// pre-approving every reply would make live discussion impossible; only
// new topics go through the queue.
model ForumTopic {
  id              Int              @id @default(autoincrement())
  categoryId      Int
  category        ForumCategory    @relation(fields: [categoryId], references: [id])
  authorId        Int
  author          User             @relation(fields: [authorId], references: [id])
  title           String
  body            String           @db.Text
  // `members_only` is only creatable by a member/admin (enforced in the
  // route, not here) and is filtered out of every list/search/detail
  // response for anyone who isn't a member or admin — general users never
  // see it exists at all.
  visibility      ForumVisibility  @default(public)
  status          ForumTopicStatus @default(pending)
  rejectionReason String?          @db.Text
  // Admin moderation flags — pin to the top of listings, or lock to block
  // new replies while keeping the topic itself visible/readable.
  pinned          Boolean          @default(false)
  locked          Boolean          @default(false)
  // Soft-delete (admin "delete/hide") — filtered out of every query rather
  // than actually removed, so content isn't unrecoverable by accident.
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  replies         ForumReply[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([visibility])
}

model ForumReply {
  id        Int        @id @default(autoincrement())
  topicId   Int
  topic     ForumTopic @relation(fields: [topicId], references: [id])
  authorId  Int
  author    User       @relation(fields: [authorId], references: [id])
  body      String     @db.Text
  // Soft-delete (admin "delete/hide"), same convention as ForumTopic.
  deletedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([topicId])
  @@index([authorId])
}

// Admin-managed digital good — either a `video` (an external Vimeo/YouTube
// link, embedded for the buyer only; the raw link is never sent to the
// browser pre-purchase) or a `file` (uploaded to this server, up to 50MB,
// downloadable by the buyer only once their order is active). Never
// hard-deleted once it has real orders — see the delete route's own check —
// so a past buyer's purchase history/access never dangles.
model Product {
  id          Int          @id @default(autoincrement())
  type        ProductType
  title       String
  description String       @db.Text
  priceCents  Int
  // Exactly one of these is set, matching `type` — enforced in the route,
  // not the schema (Prisma has no clean way to express "exactly one of A/B
  // required based on a third column").
  videoUrl    String?
  fileUrl     String?
  // Video-only preview image for the Store grid — derived server-side from
  // videoUrl (YouTube's predictable thumbnail URL, or Vimeo's oEmbed
  // response) when the product is saved, never uploaded directly.
  thumbnailUrl String?
  // A membersOnly product isn't sold in the public Store at all — any
  // member (same `hasMembership` check as portal access) gets it for free,
  // surfaced on the Portal's Resources page instead of requiring a
  // ProductOrder/Payment.
  membersOnly Boolean      @default(false)
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orders      ProductOrder[]
}

// One per purchase attempt — mirrors EventRegistration's own shape/
// convention exactly (a pending row created up front, a linked Payment
// activates it to `active`). No guest purchases: buyerId is always set,
// unlike EventRegistration's optional guest fields, since every store
// purchase requires a real account.
model ProductOrder {
  id        Int                @id @default(autoincrement())
  productId Int
  product   Product            @relation(fields: [productId], references: [id])
  buyerId   Int
  buyer     User               @relation(fields: [buyerId], references: [id])
  status    ProductOrderStatus @default(pending)
  createdAt DateTime           @default(now())
  payment   Payment?

  @@index([productId])
  @@index([buyerId])
}
