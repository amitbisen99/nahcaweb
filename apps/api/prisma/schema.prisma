generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

enum MembershipType {
  regular
  student
  institutional
  conference
}

enum MembershipStatus {
  active
  expired
  pending
}

enum CouponDiscountType {
  percent
  fixed_amount
  complimentary
}

enum PaymentType {
  membership
  donation
  conference
  endorsement
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum ArticleCategory {
  Podcast
  Presentation
  Referral
  Ethics
}

enum WebinarAccess {
  open
  members_only
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  name         String
  role         Role         @default(member)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  payments     Payment[]
  profile      MemberProfile?
}

// Extended demographic/professional questionnaire collected on the
// Regular/Student membership signup form (see the "Fields for collecting
// member information" doc). Kept separate from User so the core auth model
// stays lean — everything here is optional.
model MemberProfile {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  user                    User     @relation(fields: [userId], references: [id])
  preferredPronouns       String?
  mailingAddress          String?  @db.Text
  phone                   String?
  usesWhatsapp            Boolean?
  whatsappContactOk       Boolean?
  // string[] of selected traditions (see MEMBER_FORM_OPTIONS on the frontend)
  religiousTraditions     Json?
  religiousTraditionOther String?
  // "chaplain" | "student"
  primaryRole             String?
  // { employerName, jobTitle, employmentType }[]
  employment              Json?
  hearAboutUs             String?
  hearAboutUsOther        String?
  // string[] of selected care contexts
  careContexts            Json?
  boardCertified          Boolean?
  boardCertifiedOrg       String?
  endorsed                Boolean?
  endorsedBy              String?
  // string[] of selected organization memberships
  orgMemberships          Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Membership {
  id                   Int              @id @default(autoincrement())
  userId               Int
  user                 User             @relation(fields: [userId], references: [id])
  type                 MembershipType
  status               MembershipStatus @default(pending)
  startDate            DateTime?
  endDate              DateTime?
  priceCents           Int
  stripeSubscriptionId String?
  groupId              String?
  createdAt            DateTime         @default(now())
  payment              Payment?

  @@index([userId])
  @@index([groupId])
}

model MembershipPlan {
  id                   Int            @id @default(autoincrement())
  type                 MembershipType @unique
  name                 String
  priceCents           Int
  term                 String
  note                 String         @db.Text
  benefits             String         @db.Text
  tooltip              String?        @db.Text
  minStudents          Int?
  pricePerStudentCents Int?
  updatedAt            DateTime       @updatedAt
  createdAt            DateTime       @default(now())
}

model Donation {
  id              Int      @id @default(autoincrement())
  donorName       String
  donorEmail      String
  amountCents     Int
  purpose         String?
  recurring       Boolean  @default(false)
  stripePaymentId String?
  createdAt       DateTime @default(now())
  payment         Payment?
}

model Coupon {
  id            Int                @id @default(autoincrement())
  name          String
  code          String             @unique
  discountType  CouponDiscountType
  // Meaning depends on discountType: a 0-100 percentage for `percent`, cents
  // for `fixed_amount`, unused for `complimentary`.
  discountValue Int
  // Membership plan types this coupon can be applied to (MembershipType
  // values, e.g. ["regular","student"]). Null/empty means "applies to all
  // plans" — donation and conference-fee checkout don't consult this yet.
  appliesTo     Json?
  validFrom     DateTime?
  validTill     DateTime?
  maxUses       Int?
  usedCount     Int                @default(0)
  published     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payments      Payment[]
}

model Payment {
  id           Int           @id @default(autoincrement())
  userId       Int?
  user         User?         @relation(fields: [userId], references: [id])
  donationId   Int?          @unique
  donation     Donation?     @relation(fields: [donationId], references: [id])
  membershipId Int?          @unique
  membership   Membership?   @relation(fields: [membershipId], references: [id])
  couponId     Int?
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  type         PaymentType
  amountCents  Int
  stripeRef    String?
  status       PaymentStatus @default(pending)
  createdAt    DateTime      @default(now())
  receipt      Receipt?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([couponId])
}

model Receipt {
  id        Int      @id @default(autoincrement())
  paymentId Int      @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  sentAt    DateTime @default(now())
  emailBody String   @db.Text
}

// --- Content management (replaces the retired Strapi CMS) ---

model Event {
  id               Int           @id @default(autoincrement())
  title            String
  date             DateTime
  time             String?
  description      String?       @db.Text
  registrationLink String?
  featuredImageUrl String?
  speakers         Json?
  access           WebinarAccess @default(open)
  published        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([published])
  @@index([access])
}

model Webinar {
  id                Int           @id @default(autoincrement())
  title             String
  description       String?       @db.Text
  zoomOrYoutubeLink String?
  priceCents        Int?
  speakerInfo       String?       @db.Text
  speakers          Json?
  featuredImageUrl  String?
  access            WebinarAccess @default(open)
  published         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([published])
  @@index([access])
}

model ConferenceVideo {
  id        Int      @id @default(autoincrement())
  title     String
  videoUrl  String
  year      Int?
  category  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model Article {
  id           Int             @id @default(autoincrement())
  title        String
  richTextBody String?         @db.Text
  category     ArticleCategory
  published    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([published])
}

model Newsletter {
  id                   Int       @id @default(autoincrement())
  title                String
  fileUrl              String?
  mailchimpCampaignUrl String?
  publishedDate        DateTime?
  published            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([published])
}

model Board {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  bio       String?  @db.Text
  photoUrl  String?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}
