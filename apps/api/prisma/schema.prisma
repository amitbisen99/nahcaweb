generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

enum MembershipType {
  regular
  student
  institutional
  conference
}

enum MembershipStatus {
  active
  expired
  pending
}

enum CouponDiscountType {
  percent
  fixed_amount
  complimentary
}

enum PaymentType {
  membership
  donation
  conference
  endorsement
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum ArticleCategory {
  Podcast
  Presentation
  Referral
  Ethics
}

enum WebinarAccess {
  open
  members_only
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  name         String
  role         Role         @default(member)
  // Admin-controlled login gate — set false to block sign-in without
  // deleting the account or its purchase history. Checked at login only
  // (doesn't invalidate an already-issued JWT mid-session).
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  payments     Payment[]
  profile      MemberProfile?
  // Set only for the institution's own login (the paying party) — see
  // InstitutionSponsorship for the institution-sponsored-membership feature.
  institutionSponsorship InstitutionSponsorship?
  claimedCodes           InstitutionClaimCode[]
  passwordResetTokens    PasswordResetToken[]
}

// Single-use, expiring token emailed as a link on "forgot password". See
// POST /auth/forgot-password (creates) and POST /auth/reset-password
// (consumes) in routes/auth.ts.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Extended demographic/professional questionnaire collected on the
// Regular/Student membership signup form (see the "Fields for collecting
// member information" doc). Kept separate from User so the core auth model
// stays lean — everything here is optional.
model MemberProfile {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  user                    User     @relation(fields: [userId], references: [id])
  preferredPronouns       String?
  mailingAddress          String?  @db.Text
  phone                   String?
  usesWhatsapp            Boolean?
  whatsappContactOk       Boolean?
  // string[] of selected traditions (see MEMBER_FORM_OPTIONS on the frontend)
  religiousTraditions     Json?
  religiousTraditionOther String?
  // "chaplain" | "student"
  primaryRole             String?
  // { employerName, jobTitle, employmentType }[]
  employment              Json?
  hearAboutUs             String?
  hearAboutUsOther        String?
  // string[] of selected care contexts
  careContexts            Json?
  boardCertified          Boolean?
  boardCertifiedOrg       String?
  endorsed                Boolean?
  endorsedBy              String?
  // string[] of selected organization memberships
  orgMemberships          Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Membership {
  id                   Int              @id @default(autoincrement())
  userId               Int
  user                 User             @relation(fields: [userId], references: [id])
  type                 MembershipType
  status               MembershipStatus @default(pending)
  startDate            DateTime?
  endDate              DateTime?
  priceCents           Int
  stripeSubscriptionId String?
  // Institutional only: null on the institution's own paying membership,
  // set to the InstitutionSponsorship id (as a string) on a sponsored
  // student's membership — that's how the two are told apart.
  groupId              String?
  // Institutional only: seats purchased. Used to size each claim-code batch.
  studentCount         Int?
  createdAt            DateTime         @default(now())
  payment              Payment?

  @@index([userId])
  @@index([groupId])
}

// One per institution — created when their sponsorship subscription first
// activates (see activatePayment in paymentActivation.ts). Renewed in place
// every 24 months (see the Stripe webhook's invoice.paid handling), which
// extends endDate and adds a fresh batch of claim codes.
model InstitutionSponsorship {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  user                 User     @relation(fields: [userId], references: [id])
  seatCount            Int
  stripeSubscriptionId String?
  startDate            DateTime
  endDate              DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  codes                InstitutionClaimCode[]

  @@index([stripeSubscriptionId])
}

// A single-use code from a sponsorship's batch. Redeemed via POST
// /institutions/claim (new student) or POST /institutions/redeem (existing
// member extending) — either way it results in a new Membership row.
model InstitutionClaimCode {
  id              Int                     @id @default(autoincrement())
  sponsorshipId   Int
  sponsorship     InstitutionSponsorship  @relation(fields: [sponsorshipId], references: [id])
  code            String                  @unique
  claimedByUserId Int?
  claimedByUser   User?                   @relation(fields: [claimedByUserId], references: [id])
  claimedAt       DateTime?
  createdAt       DateTime                @default(now())

  @@index([sponsorshipId])
}

model MembershipPlan {
  id                   Int            @id @default(autoincrement())
  type                 MembershipType @unique
  name                 String
  priceCents           Int
  term                 String
  note                 String         @db.Text
  benefits             String         @db.Text
  tooltip              String?        @db.Text
  minStudents          Int?
  pricePerStudentCents Int?
  updatedAt            DateTime       @updatedAt
  createdAt            DateTime       @default(now())
}

model Donation {
  id              Int      @id @default(autoincrement())
  donorName       String
  donorEmail      String
  amountCents     Int
  purpose         String?
  recurring       Boolean  @default(false)
  stripePaymentId String?
  createdAt       DateTime @default(now())
  payment         Payment?
}

model Coupon {
  id            Int                @id @default(autoincrement())
  name          String
  code          String             @unique
  discountType  CouponDiscountType
  // Meaning depends on discountType: a 0-100 percentage for `percent`, cents
  // for `fixed_amount`, unused for `complimentary`.
  discountValue Int
  // What this coupon can be applied to — a JSON array of membership plan
  // types ("regular"/"student"/"institutional") and/or the sentinel value
  // "nahca_programmes" (an Event/Webinar, via eventCode below). At least
  // one entry is required going forward (enforced in the API, not the DB —
  // stays nullable so pre-existing coupons created under the old "empty
  // means applies to everything" rule aren't broken by this migration).
  appliesTo     Json?
  // Set only when appliesTo includes "nahca_programmes" — the specific
  // Event.eventCode or Webinar.eventCode this coupon is scoped to. Not a
  // real foreign key since it can point at either table; existence is
  // checked in the API on save. Not consulted by any checkout flow yet —
  // event/webinar payment + coupon redemption is a future phase.
  eventCode     String?
  validFrom     DateTime?
  validTill     DateTime?
  maxUses       Int?
  usedCount     Int                @default(0)
  published     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payments      Payment[]
}

model Payment {
  id           Int           @id @default(autoincrement())
  userId       Int?
  user         User?         @relation(fields: [userId], references: [id])
  donationId   Int?          @unique
  donation     Donation?     @relation(fields: [donationId], references: [id])
  membershipId Int?          @unique
  membership   Membership?   @relation(fields: [membershipId], references: [id])
  couponId     Int?
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  type         PaymentType
  amountCents  Int
  stripeRef    String?
  status       PaymentStatus @default(pending)
  createdAt    DateTime      @default(now())
  receipt      Receipt?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([couponId])
}

model Receipt {
  id        Int      @id @default(autoincrement())
  paymentId Int      @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  sentAt    DateTime @default(now())
  emailBody String   @db.Text
}

// --- Content management (replaces the retired Strapi CMS) ---

model Event {
  id               Int           @id @default(autoincrement())
  title            String
  date             DateTime
  time             String?
  description      String?       @db.Text
  registrationLink String?
  featuredImageUrl String?
  speakers         Json?
  access           WebinarAccess @default(open)
  published        Boolean       @default(false)
  // Unique, admin-facing code generated on creation (see lib/eventCodes.ts)
  // — used to scope a Coupon to this specific event.
  eventCode        String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([published])
  @@index([access])
}

model Webinar {
  id                Int           @id @default(autoincrement())
  title             String
  description       String?       @db.Text
  zoomOrYoutubeLink String?
  priceCents        Int?
  speakerInfo       String?       @db.Text
  speakers          Json?
  featuredImageUrl  String?
  access            WebinarAccess @default(open)
  published         Boolean       @default(false)
  // Unique, admin-facing code generated on creation (see lib/eventCodes.ts)
  // — used to scope a Coupon to this specific webinar.
  eventCode         String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([published])
  @@index([access])
}

model ConferenceVideo {
  id        Int      @id @default(autoincrement())
  title     String
  videoUrl  String
  year      Int?
  category  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model Article {
  id           Int             @id @default(autoincrement())
  title        String
  richTextBody String?         @db.Text
  category     ArticleCategory
  published    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([published])
}

model Newsletter {
  id                   Int       @id @default(autoincrement())
  title                String
  fileUrl              String?
  mailchimpCampaignUrl String?
  publishedDate        DateTime?
  published            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([published])
}

// Local record of who signed up via the site footer's "Get our monthly
// newsletter & updates" form — NOT the same thing as the Newsletter model
// above (that's published newsletter PDFs). Brevo is the actual mailing
// list (see lib/brevoContacts.ts); this table exists purely so admins have
// a record of footer signups without needing to log into Brevo. Members are
// pushed to the same Brevo list directly from their signup/claim flow and
// don't get a row here (they're already tracked as Users).
model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Board {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  bio       String?  @db.Text
  photoUrl  String?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}
