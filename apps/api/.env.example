PORT=4000

# MySQL — XAMPP default root user has no password locally
DATABASE_URL="mysql://root:@localhost:3306/nahca_app"

JWT_SECRET=replace-with-a-long-random-string

# Demo/staging escape hatch — skips Stripe entirely and marks memberships/donations
# active immediately. Set to "false" (or remove) once real Stripe keys are added.
PAYMENTS_BYPASS=true

# Stripe (test mode keys — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Brevo transactional email (https://app.brevo.com/settings/keys/api) — the
# from-address must be a verified sender in Brevo or sends will fail.
BREVO_API_KEY=placeholder
BREVO_FROM_EMAIL=noreply@hinduchaplains.com
BREVO_FROM_NAME=NAHCA

# Internal notification sent whenever a membership purchase activates. Leave
# unset to skip it.
ADMIN_NOTIFICATION_EMAIL=

# Brevo contact lists (IDs belong to one Brevo account, so they change with the account).
#   4 = members (active memberships)
#   5 = newsletter subscribers (footer sign-ups)
#   6 = general users (free accounts with no active membership)
#   7 = spare, not used yet
BREVO_LIST_ID_4=
BREVO_LIST_ID_5=
BREVO_LIST_ID_6=
BREVO_LIST_ID_7=

# Org details used on receipts / tax letters
ORG_NAME="North American Hindu Chaplains Association"
ORG_EIN="00-0000000"

# Frontend origin allowed to call this API (CORS) — must be the real deployed
# web app URL (e.g. https://portal.hinduchaplains.com) on any non-local
# deployment, or browser requests to this API will be blocked.
WEB_ORIGIN=http://localhost:3000
